# Paper Trail — local configuration
# Copy to .env (the server does not load .env automatically; set these in your shell or use a
# launcher). .env is gitignored.

# --- server -------------------------------------------------------------------------------
PAPERTRAIL_PORT=8765
PAPERTRAIL_HOST=127.0.0.1
PAPERTRAIL_DATA_DIR=data

# --- demo mode ----------------------------------------------------------------------------
# 1 = force demo mode (recorded sample answers, zero network calls); unset = auto
# (auto is demo when GEMINI_API_KEY is missing).
# PAPERTRAIL_DEMO=1

# --- hosted Gemma 4 via Gemini API (live mode) --------------------------------------------
# Get a key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=replace-me
PAPERTRAIL_MODEL=gemma-4-26b-a4b-it
# PAPERTRAIL_API_BASE=https://generativelanguage.googleapis.com

# --- local model instead of hosted (offline) ----------------------------------------------
# PAPERTRAIL_BACKEND=openai
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1        # Ollama
# OPENAI_BASE_URL=http://127.0.0.1:9379/v1         # LiteRT-LM serve
# OPENAI_MODEL=gemma4:12b
# OPENAI_API_KEY=local

# --- limits -------------------------------------------------------------------------------
PAPERTRAIL_MAX_FILE_MB=12
PAPERTRAIL_TRANSCRIBE=1
PAPERTRAIL_TRANSCRIBE_MAX_PAGES=8
